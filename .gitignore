node_modules/
dist/
.omc/
# Codex(oh-my-codex) 실행 상태
.omx/
.env
.env.*
!.env.example
.DS_Store
# Codex용으로 복사한 지침·스킬 (원본은 CLAUDE.md, .claude/skills)
/AGENTS.md
/.agents/
# 평가 결과 (공유할 결과는 docs로 옮겨 기록)
/eval/results/
# 설문 응답 (서버에만 남김)
/eval/survey/data/

# Claude 스킬 더미 (외부에서 설치, 저장소에 포함하지 않음). collab-rules는 프로젝트 규칙이라 예외
/.claude/skills/
!/.claude/skills/collab-rules/
/skills-lock.json
# 개인 발표자료 초안 등 docs 폴더의 HTML (eval 등 다른 곳의 HTML은 커밋함)
/docs/*.html
