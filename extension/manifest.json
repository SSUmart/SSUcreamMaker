{
  "manifest_version": 3,
  "name": "온글",
  "short_name": "온글",
  "description": "그림 속 글자와 긴 페이지를 AI로 읽어 스크린리더가 읽을 수 있는 글로 바꿔 줍니다. 상세 이미지 읽기, 페이지 요약, 질문 응답, 항목 설명.",
  "version": "0.0.0",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "온글: 상세 이미지 읽기 (Alt+Shift+D)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "read-detail": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "상세 이미지 읽기"
    },
    "summarize-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "페이지 요약"
    },
    "ask-page": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "페이지에 질문하기"
    },
    "explain-mode": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "항목 설명 모드 켜기/끄기 (켜진 동안 클릭한 항목을 설명)"
    }
  },
  "options_page": "options/options.html"
}
