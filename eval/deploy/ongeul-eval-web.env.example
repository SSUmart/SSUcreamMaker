# /etc/ongeul-eval-web.env 로 복사해 고친 뒤 권한을 막는다:
#   sudo cp eval/deploy/ongeul-eval-web.env.example /etc/ongeul-eval-web.env
#   sudo chmod 600 /etc/ongeul-eval-web.env && sudo chown root:root /etc/ongeul-eval-web.env

# 듣는 주소와 포트.
#   0.0.0.0   : 다른 기기에서 접속할 수 있음. 도메인을 넘겨주는 프록시·터널(nginx, Cloudflare 터널, 공유기 등)이
#               다른 기기에 있거나, 다른 PC에서 http://<서버 IP>:8080 으로 바로 열 때 (SSU-DEV는 이 경우)
#   127.0.0.1 : 이 서버 안에서만 접속됨. nginx·cloudflared가 같은 서버에서 넘겨줄 때만 (다른 기기의 프록시는 502가 남)
HOST=0.0.0.0
PORT=8080

# 첫 주소(/)로 들어오면 갈 곳
START=/mall/

# 평가 설문 관리자 비밀번호. 비워 두면 설문(/survey/)만 꺼지고 쇼핑몰은 그대로 열린다
SURVEY_ADMIN_PASSWORD=여기에-추측하기-어려운-긴-비밀번호

# 설문 주소 앞부분과 응답 저장 폴더 (기본값을 쓰면 지우거나 그대로 둔다)
SURVEY_PATH=/survey
# SURVEY_DATA_DIR=/opt/ssu/SSUcreamMaker/eval/survey/data
